@echo off
rem Generate GraalVM reflection configuration using the tracing agent
rem cd /d %coderepos%\xyz-jphil\xyz-jphil-git_cli_proxy_with_creds
cd..
echo [1/2] Checking for existing JAR...
if not exist target\xyz-jphil-git_cli_proxy_with_creds-1.0.0-uber.jar (
    echo Building JAR...
    call mvnd package
    if %ERRORLEVEL% NEQ 0 (
        echo JAR build failed
        exit /b %ERRORLEVEL%
    )
) else (
    echo Using existing JAR
)

echo.
echo [2/2] Running with GraalVM tracing agent...
echo This will execute the application and generate reflection configuration.
echo.

rem Clear any existing config files generated by agent
if exist src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\reflect-config.json del src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\reflect-config.json
if exist src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\jni-config.json del src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\jni-config.json
if exist src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\resource-config.json del src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\resource-config.json
if exist src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\serialization-config.json del src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\serialization-config.json
if exist src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\proxy-config.json del src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\proxy-config.json
if exist src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\predefined-classes-config.json del src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\predefined-classes-config.json

echo Running: java -agentlib:native-image-agent=config-output-dir=... -jar target/xyz-jphil-git_cli_proxy_with_creds-1.0.0-uber.jar
echo.

rem Run the JAR with the tracing agent (no args to trigger account detection)
"%GRAALVM_HOME%\bin\java" -agentlib:native-image-agent=config-output-dir=src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds -jar target\xyz-jphil-git_cli_proxy_with_creds-1.0.0-uber.jar

echo.
echo Configuration files generated in:
echo src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\
echo.
echo Files created:
dir src\main\resources\META-INF\native-image\xyz.jphil.git_cli_proxy_with_creds\*.json /b 2>nul

echo.
echo Now you can build the native image with this configuration:
echo   test-scripts\build-native.bat
